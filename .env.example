# Server-only configuration. Never commit real values or paste them into chat.
# Set these in your own Vercel project's environment variables, then redeploy.
# The preflight route is disabled until both settings below are configured.
LAB_PREFLIGHT_ENABLED=false
LAB_ACCESS_KEY=

# Trello: a personal Free Workspace and a disposable practice list.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# Resend: use the address associated with your own Resend account.
RESEND_API_KEY=
LAB_EMAIL_TO=

# Supabase: deploy the included narrow write-back function in your own project.
LAB_SUPABASE_URL=

# GitHub: a fine-grained token restricted to your own practice repository.
# Permissions: Contents read/write and Pull requests read/write.
LAB_GITHUB_TOKEN=
LAB_GITHUB_REPOSITORY=
LAB_GITHUB_BASE_BRANCH=main
LAB_GITHUB_POLICY_PATH=classroom-fixtures/review-policy.json
